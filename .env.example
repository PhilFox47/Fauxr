# Copy to .env and fill in. Everything here is optional - the settings page
# can set all of it at runtime, and values saved there win over these.
FAUXR_PORT=8080
TZ=Europe/Berlin

FAUXR_API_BASE_URL=https://nano-gpt.com/api/v1
FAUXR_API_KEY=
FAUXR_IMAGE_BASE_URL=https://nano-gpt.com/api/v1
FAUXR_IMAGE_API_KEY=
